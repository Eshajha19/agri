# Firebase Configuration - Get these from Firebase Console > Project Settings > Your Apps
# IMPORTANT: For Vercel deployment, go to Firebase Console > Authentication > Settings
# and add your Vercel domain (e.g., fasal-saathi.vercel.app) to "Authorized domains"
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your_app_id

# Base URL of the backend API.
# For local development and Codespaces, set this to your backend URL:
# VITE_API_BASE_URL=http://localhost:8000
# For Vercel production, set this to your Render backend URL:
# VITE_API_BASE_URL=https://agri-5ydw.onrender.com
# Leave empty ONLY if you are running `npm run dev` with the Vite proxy enabled.
VITE_API_BASE_URL=

# Note: No backend = No authenticated API calls. Only Firebase Auth UI will work.
# Google sign-in popup works without a backend - it authenticates directly with Firebase.

VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# EmailJS Configuration - Get these from https://www.emailjs.com/
# Used for sending daily farm reminder emails from the activity calendar.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Rate Limiting
FEEDBACK_RATE_LIMIT=120/minute